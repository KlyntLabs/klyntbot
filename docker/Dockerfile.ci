# syntax=docker/dockerfile:1
# Reproducible Ubuntu CI environment that mirrors .github/workflows/ci.yml
# and the Linux release build path. Run with:
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.ci -t klyntbot:ci .
FROM --platform=linux/amd64 ubuntu:24.04 AS ci-base

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:/usr/local/bun/bin:$PATH \
    CI=true

# System dependencies needed by the workspace, Tauri and the Linux sandbox tests.
RUN apt-get update && apt-get install -y \
    curl ca-certificates build-essential pkg-config libssl-dev \
    libgtk-3-dev libwebkit2gtk-4.1-dev libappindicator3-dev \
    librsvg2-dev libglib2.0-dev libasound2-dev libfuse2 patchelf \
    protobuf-compiler libprotobuf-dev bubblewrap unzip git python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Rust toolchain (mirrors dtolnay/rust-toolchain@stable with rustfmt + clippy)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain stable --component rustfmt,clippy

# cargo-binstall, then use it for fast installs of heavy CLI crates.
RUN curl -L --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh \
    | bash
RUN cargo binstall cargo-nextest -y && cargo binstall tauri-cli -y

# Bun (frontend toolchain)
RUN curl -fsSL https://bun.sh/install | bash

WORKDIR /app

# Copy the full source tree. .dockerignore keeps the image small.
COPY . .

# Build the Linux sandbox helper and put it on PATH so klynt-sandbox tests can find it.
RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build -p klynt-sandbox-helper && \
    cp target/debug/klynt-sandbox-helper /usr/local/bin/klynt-sandbox-helper && \
    chmod +x /usr/local/bin/klynt-sandbox-helper

# Install frontend dependencies (frozen lockfile, CI mode).
RUN cd desktop-ui && bun install --frozen-lockfile

# --- CI quality gates (same commands as .github/workflows/ci.yml rust-quality job) ---
RUN cargo fmt --all --check

RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo clippy --workspace --all-targets --all-features -- -D warnings

RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    cargo nextest run --workspace --all-features

# --- Full Linux release artifact smoke test (AppImage + updater signing) ---
# Generate a throwaway signing key inside the container so the build can create
# .sig files. The public key in tauri.conf.json is for the real release; this
# key is only used to exercise the build pipeline.
RUN cargo tauri signer generate --ci --password docker-ci-pass -w /tmp/docker-sign-key --force >/dev/null 2>&1
RUN --mount=type=cache,target=/app/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    export TAURI_SIGNING_PRIVATE_KEY="$(cat /tmp/docker-sign-key)" && \
    export TAURI_KEY_PASSWORD="docker-ci-pass" && \
    cd crates/desktop && \
    cargo tauri build --target x86_64-unknown-linux-gnu --bundles appimage

# Keep the image around for inspection; the build itself is the test.
