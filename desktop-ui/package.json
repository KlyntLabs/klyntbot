{
  "name": "codex-monitor",
  "private": true,
  "version": "0.7.68",
  "type": "module",
  "scripts": {
    "sync:material-icons": "node scripts/sync-material-icons.mjs",
    "postinstall": "bun run sync:material-icons",
    "predev": "bun run sync:material-icons",
    "dev": "vite",
    "prebuild": "bun run sync:material-icons",
    "build": "tsc && vite build",
    "build:appimage": "NO_STRIP=1 tauri build --bundles appimage",
    "doctor": "sh scripts/doctor.sh",
    "doctor:strict": "sh scripts/doctor.sh --strict",
    "doctor:win": "node scripts/doctor.mjs --strict",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:ds": "eslint . --ext .ts,.tsx",
    "codemod:modal-shell": "node scripts/codemods/modal-shell-codemod.mjs",
    "codemod:panel-shell": "node scripts/codemods/panel-shell-codemod.mjs",
    "codemod:toast-shell": "node scripts/codemods/toast-shell-codemod.mjs",
    "codemod:ds:dry": "bun run codemod:modal-shell -- --dry-run && bun run codemod:panel-shell -- --dry-run && bun run codemod:toast-shell -- --dry-run",
    "codemod:ds": "bun run codemod:modal-shell && bun run codemod:panel-shell && bun run codemod:toast-shell",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "pretauri:dev": "bun run sync:material-icons",
    "tauri:dev": "bun run doctor:strict && tauri dev",
    "pretauri:build": "bun run sync:material-icons",
    "tauri:build": "bun run doctor:strict && tauri build",
    "pretauri:dev:win": "bun run sync:material-icons",
    "tauri:dev:win": "bun run doctor:win && tauri dev --config src-tauri/tauri.windows.conf.json",
    "pretauri:build:win": "bun run sync:material-icons",
    "tauri:build:win": "bun run doctor:win && tauri build --config src-tauri/tauri.windows.conf.json"
  },
  "dependencies": {
    "@pierre/diffs": "^1.1.19",
    "@sentry/react": "^10.50.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.11.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tauri-plugin-liquid-glass-api": "^0.1.6",
    "vscode-material-icons": "^0.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/react": "^16.3.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
