{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noArrayIndexKey": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "warn"
      },
      "complexity": {
        "noImportantStyles": "warn"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["src/features/notes/components/editor/vim/vim-engine.js"],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    }
  ],
  "files": {
    "includes": ["src/**"],
    "experimentalScannerIgnores": ["dist/**", "node_modules/**"]
  }
}
