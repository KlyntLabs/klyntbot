{
  "productName": "Klynt",
  "version": "0.1.0",
  "identifier": "com.klynt.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../../desktop-ui"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KlyntLabs/klynt-bot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDBFMjA0OUFEREIyNzUKUldSMXN0MmFCT0lBMjJ5MlQ4dEtzd1Q3SjhieDM5Q2l3cSs1TlArNUpxajMrMkR1SmZzbzl4T3cK"
    }
  }
}
