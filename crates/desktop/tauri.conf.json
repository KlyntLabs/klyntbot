{
  "productName": "Klynt",
  "version": "0.1.0",
  "identifier": "com.klynt.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../../desktop-ui && bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "launcher",
        "url": "/#/launcher",
        "title": "",
        "width": 660,
        "height": 580,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 16.0
        }
      },
      {
        "label": "tray",
        "url": "/#/tray",
        "title": "",
        "width": 320,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 16.0
        }
      },
      {
        "label": "distraction-overlay",
        "url": "/#/distraction-overlay",
        "title": "",
        "width": 340,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "focus": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 16.0
        }
      },
      {
        "label": "quick-capture",
        "url": "/#/quick-capture",
        "title": "",
        "width": 500,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active",
          "radius": 16.0
        }
      },
      {
        "label": "voice-orb",
        "url": "/#/voice-orb",
        "title": "",
        "width": 360,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": false,
        "focus": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KlyntLabs/klynt-bot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDBFMjA0OUFEREIyNzUKUldSMXN0MmFCT0lBMjJ5MlQ4dEtzd1Q3SjhieDM5Q2l3cSs1TlArNUpxajMrMkR1SmZzbzl4T3cK"
    }
  }
}
