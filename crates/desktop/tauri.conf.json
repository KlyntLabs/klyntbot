{
  "productName": "Klynt",
  "version": "0.1.1",
  "identifier": "com.klynt.app",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev:vite",
      "cwd": "../../desktop-ui"
    },
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../../desktop-ui"
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "visible": false,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": ["hudWindow"],
          "state": "active"
        }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/KlyntLabs/klynt-bot/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDBFMjA0OUFEREIyNzUKUldSMXN0MmFCT0lBMjJ5MlQ4dEtzd1Q3SjhieDM5Q2l3cSs1TlArNUpxajMrMkR1SmZzbzl4T3cK"
    }
  }
}
